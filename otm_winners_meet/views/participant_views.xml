<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wm_participant_list" model="ir.ui.view">
        <field name="name">otm.wm.participant.list</field>
        <field name="model">otm.wm.participant</field>
        <field name="arch" type="xml">
            <list decoration-danger="approval_state == 'pending'" decoration-muted="approval_state == 'rejected'">
                <field name="name"/>
                <field name="phone"/>
                <field name="kind"/>
                <field name="category_id"/>
                <field name="claimed_category_id" optional="hide"/>
                <field name="match_status"/>
                <field name="approval_state"/>
                <field name="state"/>
                <field name="seat_label"/>
                <field name="hat_state"/>
                <field name="wa_state"/>
            </list>
        </field>
    </record>
    <record id="view_wm_participant_form" model="ir.ui.view">
        <field name="name">otm.wm.participant.form</field>
        <field name="model">otm.wm.participant</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="approval_state == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="approval_state == 'rejected' or state == 'checked_in'"/>
                    <field name="approval_state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="place"/>
                            <field name="instagram"/>
                            <field name="contact_id"/>
                            <field name="bio"/>
                            <field name="profile_filename" invisible="1"/>
                            <field name="profile_file" filename="profile_filename"/>
                            <field name="institution"/>
                        </group>
                        <group>
                            <field name="claimed_category_id"/>
                            <field name="category_id"/>
                            <field name="match_status"/>
                            <field name="match_note"/>
                            <field name="state"/>
                            <field name="photo" widget="image" options="{'size': [96, 96]}"/>
                            <field name="food_pref"/>
                            <field name="accompany_type"/>
                            <field name="accompany_count"/>
                            <field name="reserved_seat_id"/>
                            <field name="seat_id"/>
                            <field name="hat_state"/>
                            <field name="trophy_state"/>
                            <field name="wa_state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_wm_participant_search" model="ir.ui.view">
        <field name="name">otm.wm.participant.search</field>
        <field name="model">otm.wm.participant</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="seat_label"/>
                <filter name="needs_review" string="Needs Review" domain="[('approval_state', '=', 'pending')]"/>
                <filter name="checked_in" string="Checked In" domain="[('state', '=', 'checked_in')]"/>
                <filter name="hat_pending" string="Hat Pending Return" domain="[('hat_state', '=', 'issued')]"/>
                <separator/>
                <group>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_approval" string="Approval" context="{'group_by': 'approval_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_wm_participant" model="ir.actions.act_window">
        <field name="name">Participants</field>
        <field name="res_model">otm.wm.participant</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_wm_participant_review" model="ir.actions.act_window">
        <field name="name">Review Queue</field>
        <field name="res_model">otm.wm.participant</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state', '=', 'pending')]</field>
    </record>

    <record id="view_wm_expected_list" model="ir.ui.view">
        <field name="name">otm.wm.expected.list</field>
        <field name="model">otm.wm.expected</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="event_id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>
    <record id="action_wm_expected" model="ir.actions.act_window">
        <field name="name">Winners List</field>
        <field name="res_model">otm.wm.expected</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_wm_log_list" model="ir.ui.view">
        <field name="name">otm.wm.message.log.list</field>
        <field name="model">otm.wm.message.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" create="0">
                <field name="create_date"/>
                <field name="participant_id"/>
                <field name="message_type"/>
                <field name="number"/>
                <field name="state"/>
                <field name="error"/>
                <button name="action_retry" type="object" string="Retry" invisible="state not in ('failed', 'skipped')"/>
            </list>
        </field>
    </record>
    <record id="action_wm_log" model="ir.actions.act_window">
        <field name="name">WhatsApp Log</field>
        <field name="res_model">otm.wm.message.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
