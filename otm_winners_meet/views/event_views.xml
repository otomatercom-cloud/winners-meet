<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wm_event_list" model="ir.ui.view">
        <field name="name">otm.wm.event.list</field>
        <field name="model">otm.wm.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="venue"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_wm_event_form" model="ir.ui.view">
        <field name="name">otm.wm.event.form</field>
        <field name="model">otm.wm.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="date"/>
                            <field name="time_text"/>
                            <field name="venue"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="reg_student_open"/>
                            <field name="reg_teacher_open"/>
                            <field name="teacher_needs_approval"/>
                            <field name="frontend_url"/>
                            <field name="frontend_url_teacher"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Courses" name="page_courses">
                            <field name="course_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kit Items" name="page_items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Categories" name="page_categories">
                            <field name="category_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="course_id"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="item_ids" widget="many2many_tags"/>
                                    <field name="seat_block_id"/>
                                    <field name="seat_from"/>
                                    <field name="seat_to"/>
                                    <field name="seat_mode"/>
                                    <field name="self_select"/>
                                    <field name="color"/>
                                </list>
                            </field>
                        </page>
                        <page string="Seat Blocks" name="page_blocks">
                            <field name="block_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="prefix"/>
                                    <field name="start_no"/>
                                    <field name="end_no"/>
                                    <field name="row_size"/>
                                    <field name="row_layout"/>
                                    <field name="row_names"/>
                                </list>
                            </field>
                        </page>
                        <page string="WhatsApp Templates" name="page_whatsapp">
                            <group>
                                <field name="wa_tpl_confirm"/>
                                <field name="wa_msg_confirm"/>
                                <field name="wa_tpl_seat"/>
                                <field name="wa_msg_seat"/>
                                <field name="wa_tpl_confirm_teacher"/>
                                <field name="wa_msg_confirm_teacher"/>
                                <field name="wa_tpl_seat_teacher"/>
                                <field name="wa_seat_hat_param"/>
                                <field name="wa_msg_seat_teacher"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_wm_event" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">otm.wm.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
