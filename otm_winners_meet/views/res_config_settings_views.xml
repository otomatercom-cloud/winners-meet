<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.otm.winners.meet</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Winners Meet" string="Winners Meet" name="otm_winners_meet"
                     groups="otm_winners_meet.group_wm_manager">
                    <block title="WhatsApp" name="wm_whatsapp_block">
                        <setting string="Winners Meet WhatsApp"
                                 help="Leave credentials blank to reuse the Student Attendance WhatsApp setup.">
                            <field name="wm_wa_enabled"/>
                        </setting>
                        <setting string="Credentials" help="Only fill these to use a different number than attendance.">
                            <div class="content-group">
                                <div class="row mt8"><label for="wm_wa_provider" class="col-lg-4"/><field name="wm_wa_provider"/></div>
                                <div class="row mt8"><label for="wm_wa_meta_phone_id" class="col-lg-4"/><field name="wm_wa_meta_phone_id"/></div>
                                <div class="row mt8"><label for="wm_wa_meta_token" class="col-lg-4"/><field name="wm_wa_meta_token" password="True"/></div>
                                <div class="row mt8"><label for="wm_wa_template_lang" class="col-lg-4"/><field name="wm_wa_template_lang"/></div>
                                <div class="row mt8"><label for="wm_wa_country_code" class="col-lg-4"/><field name="wm_wa_country_code"/></div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
