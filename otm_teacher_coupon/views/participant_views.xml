<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coupon_owner_list" model="ir.ui.view">
        <field name="name">otm.wm.participant.coupon.list</field>
        <field name="model">otm.wm.participant</field>
        <field name="arch" type="xml">
            <list string="Coupons" create="0" edit="0" delete="0">
                <field name="coupon_code"/>
                <field name="name" string="Owner"/>
                <field name="kind" widget="badge"/>
                <field name="phone"/>
                <field name="institution" string="College"/>
                <field name="event_id"/>
                <field name="coupon_approved" string="Approved Uses" sum="Total"/>
                <field name="coupon_pending" string="Pending"/>
                <field name="coupon_slots_left"/>
                <field name="coupon_discount_total" sum="Total"/>
                <field name="wallet_balance" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_coupon_owner_search" model="ir.ui.view">
        <field name="name">otm.wm.participant.coupon.search</field>
        <field name="model">otm.wm.participant</field>
        <field name="arch" type="xml">
            <search>
                <field name="coupon_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="institution"/>
                <filter name="f_used" string="Used at least once" domain="[('coupon_usage_ids.state', '=', 'approved')]"/>
                <filter name="f_pend" string="Has pending" domain="[('coupon_usage_ids.state', '=', 'pending')]"/>
                <filter name="f_teacher" string="Teachers" domain="[('kind', '=', 'teacher')]"/>
                <filter name="f_student" string="Students" domain="[('kind', '=', 'student')]"/>
            </search>
        </field>
    </record>
    <record id="action_coupon_owners" model="ir.actions.act_window">
        <field name="name">Coupons</field>
        <field name="res_model">otm.wm.participant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('coupon_code', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_coupon_owner_list')})]"/>
        <field name="search_view_id" ref="view_coupon_owner_search"/>
    </record>
</odoo>
