<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coupon_payout_wizard" model="ir.ui.view">
        <field name="name">otm.coupon.payout.wizard.form</field>
        <field name="model">otm.coupon.payout.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Wallet">
                <group>
                    <field name="participant_id"/>
                    <field name="balance"/>
                    <field name="amount"/>
                    <field name="reference"/>
                    <field name="date"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm transfer" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
